  <metadata>
    <name>Boucle enduro de Grenoble à Saint-Nizier-du-Moucherotte — Parc naturel régional du Vercors</name>
    <desc>Distance: 30.135km, Estimated duration: 3.54h, Elevation up: 1294.0m, Elevation down: 1294.0m, Grade: difficult</desc>
