    </link>
    <type>Highlight</type>
  </wpt>
  <wpt lat="45.177692" lon="5.636316">
    <ele>1117.2</ele>
    <name>Nice panorama</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k9/ha/hamzleh19uy6xwi5bb64pkym5etxdsnf-uhi88447403/0</cmt>
    <desc>Guillaume De Nîmes: Les 3 Pucelles, Grenoble et la chaîne de montagnes
――――――――――
GravelHit 3️⃣8️⃣: Vue sur les 3 Pucelles depuis la ferme Rony</desc>
    <src>Komoot</src>
