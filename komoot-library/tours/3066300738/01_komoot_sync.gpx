  <wpt lat="45.529281" lon="6.723076">
    <ele>2238.6</ele>
    <name>Start of Whitelines MTB Trail</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k7/19/1923ti7hb6g3516jxu674fyy4s2zgy5j-uhi67227721/0</cmt>
    <desc>Ben Thompson 🏔: A ribbon of singletrack that snakes down through the open mountain and then into the woods. It's tight and steep in places and recommended for experienced mountain bikers.</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/2518053">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
  <wpt lat="45.523494" lon="6.715712">
    <ele>2396.4</ele>
    <name>Orientation table at the Col de l'Arpette</name>
