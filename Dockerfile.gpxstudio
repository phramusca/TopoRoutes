FROM node:22-alpine AS build

ARG GPX_STUDIO_REF=6a0d4343718e01637a8e301251977fb218cf88f8

RUN apk add --no-cache ca-certificates git

RUN git clone https://github.com/gpxstudio/gpx.studio.git /src \
    && git -C /src checkout "${GPX_STUDIO_REF}"

RUN npm install --global npm@12.2.1 \
    && npm cache clean --force

WORKDIR /src/gpx
RUN npm ci && npm run build

WORKDIR /src/website
RUN npm ci
RUN PUBLIC_MAPTILER_KEY="" npm run build

FROM nginx:stable-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/website/build/ /usr/share/nginx/html/
