FROM node:22-bookworm-slim AS build

ARG GPX_STUDIO_REF=6a0d4343718e01637a8e301251977fb218cf88f8
ARG PUBLIC_MAPTILER_KEY=

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/gpxstudio/gpx.studio.git /src \
    && git -C /src checkout "${GPX_STUDIO_REF}"

WORKDIR /src/gpx
RUN npm ci && npm run build

WORKDIR /src/website
RUN npm ci
RUN PUBLIC_MAPTILER_KEY="${PUBLIC_MAPTILER_KEY}" npm run build

FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/website/build/ /usr/share/nginx/html/
