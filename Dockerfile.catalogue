FROM node:22-alpine AS gpx-languages

ARG GPX_STUDIO_REF=6a0d4343718e01637a8e301251977fb218cf88f8

RUN apk add --no-cache ca-certificates git \
    && git clone https://github.com/gpxstudio/gpx.studio.git /src \
    && git -C /src checkout "${GPX_STUDIO_REF}"

RUN node -e 'const fs = require("node:fs"); const src = fs.readFileSync("/src/website/src/lib/languages.ts", "utf8"); const block = src.match(/export const languages: Record<string, string> = \{([\s\S]*?)\n\};/); if (!block) throw new Error("Could not find gpx.studio languages"); const entries = [...block[1].matchAll(/^\s*(?:'\''([^'\'']+)'\''|([A-Za-z0-9-]+)):\s*'\''([^'\'']+)'\''/gm)]; const languages = Object.fromEntries(entries.map(([, quoted, bare, name]) => [quoted || bare, name])); if (!Object.keys(languages).length) throw new Error("No gpx.studio languages found"); fs.writeFileSync("/gpx_studio_languages.json", JSON.stringify(languages));'

FROM ghcr.io/astral-sh/uv:0.9.11 AS uv

FROM python:3.12-alpine

COPY --from=uv /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY scripts/ ./scripts/
COPY --from=gpx-languages /gpx_studio_languages.json ./scripts/gpx_studio_languages.json

RUN uv sync --frozen --no-dev

ENV KOMOOT_LIBRARY=/data/komoot-library
ENV GPX_STUDIO_BASE_URL=

EXPOSE 8765

CMD ["uv", "run", "--no-sync", "komoot-library", "--library", "/data/komoot-library", "web", "--host", "0.0.0.0", "--port", "8765"]
